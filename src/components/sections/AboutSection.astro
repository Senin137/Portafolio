---
// src/components/sections/AboutSection.astro
---

<section id="about" class="relative py-28 px-6 bg-gray-50 overflow-hidden">

  <!-- Decoración de fondo -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-violet-100/50 rounded-full blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/2" />
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-fuchsia-100/40 rounded-full blur-3xl pointer-events-none translate-y-1/2 -translate-x-1/2" />

  <div class="relative max-w-5xl mx-auto">

    <!-- Título de sección -->
    <div class="flex items-center gap-3 mb-16">
      <span class="text-xs uppercase tracking-widest text-violet-500 font-semibold">02. Sobre mí</span>
      <div class="flex-1 h-px bg-violet-100" />
    </div>

    <!-- Layout principal -->
    <div class="about-card grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">

      <!-- Columna izquierda: foto -->
      <div class="flex justify-center md:justify-end">
        <div class="relative">

          <!-- Marco decorativo detrás -->
          <div class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-violet-400 to-fuchsia-400 opacity-20 blur-sm" />
          <div class="absolute -bottom-3 -right-3 w-full h-full rounded-3xl border-2 border-violet-300" />

          <!-- Foto -->
          <div class="relative w-64 h-64 md:w-72 md:h-72 rounded-3xl overflow-hidden border-2 border-white shadow-xl shadow-violet-200/50">
            <img
              src="/images/perfil.jpeg"
              alt="Foto de perfil de Eladio Martinez Ambriz"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <!-- Fallback si no hay imagen -->
            <div class="absolute inset-0 bg-gradient-to-br from-violet-100 to-fuchsia-100 hidden items-center justify-center">
              <svg class="w-24 h-24 text-violet-300" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
              </svg>
            </div>
          </div>

          <!-- Badge flotante -->
          <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl px-4 py-2.5 shadow-lg border border-gray-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
            <span class="text-xs font-semibold text-gray-700">Disponible para trabajar</span>
          </div>

        </div>
      </div>

      <!-- Columna derecha: texto -->
      <div class="flex flex-col gap-6">

        <h2
          class="text-4xl md:text-5xl font-black text-gray-900 leading-tight"
          style="font-family: 'Syne', sans-serif;"
        >
          Sobre <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-fuchsia-500">mí</span>
        </h2>

        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            Soy <span class="font-semibold text-violet-700">Ingeniero en Sistemas Computacionales</span> con
            especialización en <span class="font-semibold text-violet-700">tecnologías en la nube</span> y
            <span class="font-semibold text-violet-700">desarrollo full-stack</span>, con mayor enfoque en backend.
          </p>
          <p>
            Me caracterizo por ser una persona proactiva, organizada y orientada a resultados,
            con alta capacidad de aprendizaje y sólidas habilidades para el trabajo en equipo.
            La responsabilidad, la perseverancia y la facilidad para colaborar en entornos
            dinámicos y multidisciplinarios son parte de mi día a día.
          </p>
          <p>
            Disfruto construir soluciones que escalen, sean mantenibles y aporten valor real —
            desde arquitecturas en la nube hasta interfaces que la gente realmente quiera usar.
          </p>
        </div>

        <!-- Stats rápidas -->
        <div class="grid grid-cols-3 gap-4 pt-2">
          {[
            { value: "87", label: "Promedio" },
            { value: "4+", label: "Años estudiando" },
            { value: "6+", label: "Proyectos" },
          ].map((stat) => (
            <div class="text-center p-3 rounded-xl bg-white border border-gray-100 shadow-sm">
              <p class="text-2xl font-black text-violet-600" style="font-family: 'Syne', sans-serif;">{stat.value}</p>
              <p class="text-xs text-gray-500 mt-0.5 font-medium">{stat.label}</p>
            </div>
          ))}
        </div>

        <!-- Botón CV -->
        <div class="pt-2">
          <a
            href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 px-6 py-3.5 rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white font-semibold text-sm shadow-lg shadow-violet-200 hover:shadow-violet-300 hover:scale-[1.03] transition-all duration-300"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            Curriculum Vitae
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');

  .about-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .about-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const card = document.querySelector('.about-card');
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.disconnect();
      }
    },
    { threshold: 0.15 }
  );
  if (card) observer.observe(card);
</script>