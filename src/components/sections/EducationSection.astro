---
// src/components/sections/EducationSection.astro

const education = [
  {
    degree: "Licenciatura en Ingeniería en Sistemas Computacionales",
    institution: "Instituto Tecnológico de Morelia",
    period: "2022 — Presente",
    grade: "87",
    status: "En curso",
  },
  // Agrega más entradas aquí si es necesario
];
---

<section id="education" class="relative py-28 px-6 bg-white">
  <div class="max-w-4xl mx-auto">

    <!-- Título de sección -->
    <div class="flex items-center gap-3 mb-12">
      <span class="text-xs uppercase tracking-widest text-violet-500 font-semibold">
        03. Formación
      </span>
      <div class="flex-1 h-px bg-violet-100" />
    </div>

    <!-- Tarjeta estilo ventana -->
    <div class="edu-card rounded-2xl overflow-hidden shadow-xl shadow-violet-100/60 border border-gray-100">

      <!-- Barra superior estilo browser -->
      <div class="bg-gradient-to-r from-violet-400 to-fuchsia-400 px-5 py-3.5 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-white/40" />
        <span class="w-3 h-3 rounded-full bg-white/40" />
        <span class="w-3 h-3 rounded-full bg-white/40" />
      </div>

      <!-- Cuerpo de la tarjeta -->
      <div class="bg-gray-50 px-8 md:px-12 py-10">

        <!-- Header de la tarjeta -->
        <div class="flex items-center gap-4 mb-10">
          <div class="p-3 rounded-full border-2 border-violet-300 bg-white shadow-sm">
            <svg class="w-7 h-7 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
            </svg>
          </div>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900" style="font-family: 'Syne', sans-serif;">
            Educación
          </h2>
        </div>

        <!-- Timeline -->
        <div class="relative pl-6 border-l-2 border-violet-200 space-y-10">
          {education.map((item) => (
            <div class="edu-item relative">

              <!-- Dot en la línea -->
              <div class="absolute -left-[29px] top-1.5 flex items-center justify-center">
                <span class="w-3.5 h-3.5 rounded-full bg-violet-500 ring-4 ring-violet-100 block" />
              </div>

              <!-- Contenido -->
              <div class="group bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:border-violet-200 hover:shadow-md hover:shadow-violet-100/40 transition-all duration-300">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
                  <div>
                    <h3 class="font-bold text-gray-900 text-lg leading-snug">
                      {item.degree}
                    </h3>
                    <p class="mt-1.5 text-sm text-gray-500 font-medium">
                      {item.institution}
                    </p>
                  </div>

                  <!-- Badge estado -->
                  <span class="shrink-0 self-start inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                    {item.status}
                  </span>
                </div>

                <!-- Detalles -->
                <div class="mt-4 pt-4 border-t border-gray-100 flex flex-wrap gap-4">
                  <div class="flex items-center gap-2 text-sm text-gray-500">
                    <svg class="w-4 h-4 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                      <line x1="16" y1="2" x2="16" y2="6"/>
                      <line x1="8" y1="2" x2="8" y2="6"/>
                      <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <span>{item.period}</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-gray-500">
                    <svg class="w-4 h-4 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    <span>Promedio actual: <strong class="text-gray-800">{item.grade}</strong></span>
                  </div>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');

  .edu-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .edu-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const card = document.querySelector('.edu-card');
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.disconnect();
      }
    },
    { threshold: 0.15 }
  );
  if (card) observer.observe(card);
</script>