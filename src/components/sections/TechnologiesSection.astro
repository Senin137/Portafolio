  monitor: "M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3",
  server:  "M21.75 17.25v.75a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25v-.75m19.5 0A2.25 2.25 0 0021.75 15H2.25a2.25 2.25 0 00-2.25 2.25m19.5 0v-4.5A2.25 2.25 0 0019.5 8.25H4.5a2.25 2.25 0 00-2.25 2.25v4.5m19.5 0H2.25M12 12.75h.008v.008H12v-.008z",
