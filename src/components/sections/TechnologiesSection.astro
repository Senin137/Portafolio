---

<section id="technologies" class="relative py-28 px-6 bg-white overflow-hidden">

  <!-- Decoración fondo -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-violet-50 via-white to-white pointer-events-none" />

  <div class="relative max-w-6xl mx-auto">

    <!-- Título de sección -->
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs uppercase tracking-widest text-violet-500 font-semibold">06. Tecnologías</span>
      <div class="flex-1 h-px bg-violet-100" />
    </div>

    <!-- Header -->
    <h2
      class="text-4xl md:text-5xl font-black text-gray-900 mb-14"
      style="font-family: 'Syne', sans-serif;"
    >
      Mi <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-fuchsia-500">Stack</span>
    </h2>

    <!-- Grid de categorías -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {categories.map((cat, i) => (
        <div
          class="tech-card rounded-2xl overflow-hidden shadow-md shadow-violet-100/50 border border-violet-200/50"
          style={`animation-delay: ${i * 100}ms`}
        >
          <!-- Header de categoría -->
          <div class={`bg-gradient-to-r ${cat.color} px-6 py-4 flex items-center gap-3`}>
            <div class="p-1.5 rounded-lg bg-white/20">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[cat.icon]} />
              </svg>
            </div>
            <h3 class="text-white font-bold text-lg tracking-wide" style="font-family: 'Syne', sans-serif;">
              {cat.name}
            </h3>
            <span class="ml-auto text-white/60 text-xs font-medium">{cat.techs.length} techs</span>
          </div>

          <!-- Grid de tecnologías -->
          <div class="bg-gradient-to-b from-violet-50/80 to-white p-6">
            <div class="grid grid-cols-3 gap-3">
              {cat.techs.map((tech) => (
                <div class="tech-item group flex flex-col items-center gap-2 p-3 rounded-xl bg-white border border-gray-100 hover:border-violet-300 hover:shadow-md hover:shadow-violet-100/50 hover:-translate-y-1 transition-all duration-200 cursor-default">
                  <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${cat.color} flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform duration-200`}>
                    <i class={`${tech.icon} text-xl text-white`}></i>
                  </div>
                  <span class="text-xs font-semibold text-gray-600 group-hover:text-violet-700 transition-colors text-center leading-tight">
                    {tech.name}
                  </span>
                </div>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');

  .tech-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .tech-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const cards = document.querySelectorAll('.tech-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  cards.forEach((card) => observer.observe(card));
</script>