---
// src/components/sections/ProjectsSection.astro

const projects = [
  {
    title: "RentIt",
    subtitle: "Plataforma de renta de artículos",
    stack: "React Native + Supabase",
    description:
      "Aplicación móvil full-stack con autenticación, manejo de Storage y base de datos en Supabase. Marketplace que permite rentar y prestar artículos del hogar con pagos integrados, chat en tiempo real y sistema de reputación.",
    image: `${import.meta.env.BASE_URL}images/RentIt.png`,
    tags: ["React Native", "Supabase", "TypeScript", "Stripe"],
    featured: true,
    github: "https://github.com/KuriZd/RentIt_app",
    demo: null,
  },
  {
    title: "Proyecto Techani",
    subtitle: "App de control para personas con diabetes",
    stack: "React + Node.js",
    description:
      "Dashboard para monitoreo de glucosa, registro de insulina y seguimiento de hábitos alimenticios. Incluye gráficas en tiempo real, recordatorios personalizados y sincronización en la nube.",
    image: `${import.meta.env.BASE_URL}images/techani.png`,
    tags: ["React", "Node.js", "PostgreSQL", "AWS", "Supabase"],
    featured: true,
    github: "https://github.com/alfonsonadamas/Techani-2.0",
    demo: "https://techani.net/",
  },
  {
    title: "Mi Tutor",
    subtitle: "Sistema de asistencia escolar",
    stack: "Laravel + React",
    description:
      "API en Laravel con frontend en React y en laravel para gestionar asistencias semanales por grupos. Ciclos escolares, cálculo de porcentajes, reportes dinámicos y control de acceso por roles.",
    image: `${import.meta.env.BASE_URL}images/mitutor.png`,
    tags: ["Laravel", "React", "PostgreSQL", "REST API"],
    featured: false,
    github: "https://gitlab.com/itsaulromero/mi-tutor",
    demo: null,
  },
];
---

<section id="projects" class="relative py-28 px-6 bg-gray-50 overflow-hidden">

  <!-- Decoración fondo -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-fuchsia-100/40 rounded-full blur-3xl pointer-events-none translate-x-1/3 -translate-y-1/3" />
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-violet-100/40 rounded-full blur-3xl pointer-events-none -translate-x-1/3 translate-y-1/3" />

  <div class="relative max-w-6xl mx-auto">

    <!-- Título de sección -->
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs uppercase tracking-widest text-violet-500 font-semibold">05. Proyectos</span>
      <div class="flex-1 h-px bg-violet-100" />
    </div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-14">
      <div class="flex items-center gap-4">
        <div class="p-3 rounded-2xl bg-violet-50 border border-violet-100">
          <svg class="w-8 h-8 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
          </svg>
        </div>
        <h2
          class="text-4xl md:text-5xl font-black text-gray-900"
          style="font-family: 'Syne', sans-serif;"
        >
          Mis Proyectos
        </h2>
      </div>
      <a
        href="https://github.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-sm font-semibold text-violet-600 hover:text-violet-800 transition-colors"
      >
        Ver todos en GitHub
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
        </svg>
      </a>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <div
          class={`project-card group relative rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm hover:shadow-xl hover:shadow-violet-100/50 hover:border-violet-200 transition-all duration-500 ${project.featured && i === 0 ? "md:col-span-2" : ""}`}
          style={`animation-delay: ${i * 120}ms`}
        >
          <!-- Imagen -->
          <div class={`relative overflow-hidden bg-gradient-to-br from-violet-100 to-fuchsia-100 ${project.featured && i === 0 ? "h-64 md:h-72" : "h-48"}`}>
            <img
              src={project.image}
              alt={`Captura del proyecto ${project.title}`}
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
              onerror="this.parentElement.classList.add('show-placeholder')"
            />
            <!-- Placeholder cuando no hay imagen -->
            <div class="placeholder absolute inset-0 hidden items-center justify-center">
              <svg class="w-16 h-16 text-violet-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>

            <!-- Overlay con links -->
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-end p-4 gap-2">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 px-3 py-2 rounded-full bg-white/20 backdrop-blur-sm text-white text-xs font-semibold border border-white/30 hover:bg-white/30 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  Código
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 px-3 py-2 rounded-full bg-violet-600/80 backdrop-blur-sm text-white text-xs font-semibold border border-violet-400/50 hover:bg-violet-600 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                  </svg>
                  Demo
                </a>
              )}
            </div>

            <!-- Badge featured -->
            {project.featured && (
              <div class="absolute top-3 left-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-violet-600 text-white shadow-md">
                  ★ Destacado
                </span>
              </div>
            )}
          </div>

          <!-- Contenido de la tarjeta -->
          <div class="p-6">
            <div class="mb-3">
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="text-xl font-bold text-gray-900 leading-snug" style="font-family: 'Syne', sans-serif;">
                  {project.title}
                </h3>
              </div>
              <p class="text-sm text-violet-600 font-semibold">
                {project.subtitle}
                <span class="text-gray-400 font-normal"> · {project.stack}</span>
              </p>
            </div>

            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 group-hover:bg-violet-50 group-hover:text-violet-700 group-hover:border-violet-200 border border-transparent transition-colors duration-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');

  .project-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease, transform 0.5s ease,
                box-shadow 0.5s ease, border-color 0.5s ease;
  }

  .project-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .show-placeholder .placeholder {
    display: flex !important;
  }
</style>

<script>
  const cards = document.querySelectorAll('.project-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  cards.forEach((card) => observer.observe(card));
</script>