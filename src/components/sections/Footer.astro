---
// src/components/ui/Footer.astro

const navLinks = [
  { label: "Inicio",       href: "#hero" },
  { label: "Educación",    href: "#education" },
  { label: "Proyectos",    href: "#projects" },
  { label: "Sobre Mí",     href: "#about" },
  { label: "Tecnologías",  href: "#technologies" },
];
---

<footer class="relative bg-gray-900 overflow-hidden">

  <!-- Decoración fondo -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-px bg-gradient-to-r from-transparent via-violet-500 to-transparent" />
  <div class="absolute top-0 left-0 w-80 h-80 bg-violet-900/20 rounded-full blur-3xl pointer-events-none -translate-x-1/2 -translate-y-1/2" />
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-fuchsia-900/20 rounded-full blur-3xl pointer-events-none translate-x-1/2 translate-y-1/2" />

  <div class="relative max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">

      <!-- Columna izquierda: identidad -->
      <div class="flex flex-col gap-5">
        <div>
          <h3
            class="text-2xl font-black text-white leading-tight"
            style="font-family: 'Syne', sans-serif;"
          >
            Eladio Martinez
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-400">
              Ambriz
            </span>
          </h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Ing. en Sistemas Computacionales<br />
            Desarrollador Web · Cloud
          </p>
        </div>

        <!-- Redes sociales -->
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/Senin137"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="group p-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-violet-600 hover:border-violet-500 transition-all duration-200"
          >
            <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/eladio-mart%C3%ADnez-ambriz-0713ma/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="group p-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-violet-600 hover:border-violet-500 transition-all duration-200"
          >
            <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>

        <!-- Badge disponible -->
        <div class="inline-flex items-center gap-2 w-fit px-3 py-1.5 rounded-full bg-emerald-900/30 border border-emerald-700/40">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
          <span class="text-xs font-semibold text-emerald-400">Disponible para trabajar</span>
        </div>
      </div>

      <!-- Columna central: navegación -->
      <div class="flex flex-col gap-4">
        <h4 class="text-xs uppercase tracking-widest text-gray-500 font-semibold">
          Navegación
        </h4>
        <ul class="flex flex-col gap-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex items-center gap-2 text-sm text-gray-400 hover:text-violet-400 transition-colors duration-200"
              >
                <span class="w-4 h-px bg-gray-700 group-hover:bg-violet-500 group-hover:w-6 transition-all duration-200" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna derecha: contacto -->
      <div class="flex flex-col gap-4">
        <h4 class="text-xs uppercase tracking-widest text-gray-500 font-semibold">
          Contacto
        </h4>
        <div class="flex flex-col gap-3">
          <p class="text-sm text-gray-400 leading-relaxed">
            ¿Tienes un proyecto en mente o quieres conversar? Escríbeme directo.
          </p>
          <a
            href="mailto:eladiomtta0713@gmail.com"
            class="group inline-flex items-center gap-2.5 text-sm font-medium text-gray-300 hover:text-violet-400 transition-colors duration-200"
          >
            <span class="p-1.5 rounded-lg bg-white/5 border border-white/10 group-hover:bg-violet-600/20 group-hover:border-violet-500/40 transition-all duration-200">
              <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-violet-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
            </span>
            eladiomtta0713@gmail.com
          </a>

          <a
            href="mailto:eladiomtta0713@gmail.com"
            class="mt-1 group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white text-sm font-semibold hover:shadow-lg hover:shadow-violet-900/40 hover:scale-[1.03] transition-all duration-300 w-fit"
          >
            Enviar correo
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Línea inferior -->
    <div class="mt-16 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-gray-600">
        Hecho con <span class="text-violet-500">♥</span> usando Astro + React + TailwindCSS
      </p>
      <div class="flex items-center gap-1.5">
        <span class="text-xs text-gray-600">Diseñado y desarrollado por</span>
        <span class="text-xs font-semibold text-violet-500">Eladio Martinez</span>
      </div>
    </div>

  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');
</style>