---
// src/components/sections/ExperienceSection.astro

const experiences = [
  {
    role: "Programador FullStack",
    company: "Techani",
    companyUrl: "https://techani.com",
    period: "Septiembre 2024 — Diciembre 2025",
    type: "Servicio Universitario",
    description:
      "Desarrollo y mantenimiento de aplicaciones web full-stack con enfoque en backend. Participación activa en el diseño de arquitecturas escalables, integración de APIs y despliegue de servicios en la nube. Colaboración con equipos multidisciplinarios en entornos ágiles.",
    tags: ["React", "Node.js", "AWS", "PostgreSQL"],
  },
  // Agrega más experiencias aquí
];
---

<section id="experience" class="relative py-28 px-6 bg-white overflow-hidden">

  <!-- Decoración fondo -->
  <div class="absolute top-1/2 left-0 w-72 h-72 bg-violet-50 rounded-full blur-3xl pointer-events-none -translate-x-1/2 -translate-y-1/2" />

  <div class="relative max-w-4xl mx-auto">

    <!-- Título de sección -->
    <div class="flex items-center gap-3 mb-16">
      <span class="text-xs uppercase tracking-widest text-violet-500 font-semibold">04. Experiencia</span>
      <div class="flex-1 h-px bg-violet-100" />
    </div>

    <!-- Header -->
    <div class="flex items-center gap-3 md:gap-4 mb-10 md:mb-14">
      <div class="p-2.5 md:p-3 rounded-2xl bg-violet-50 border border-violet-100 shrink-0">
        <svg class="w-6 h-6 md:w-8 md:h-8 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
        </svg>
      </div>
      <h2
        class="text-2xl sm:text-4xl md:text-5xl font-black text-gray-900 leading-tight"
        style="font-family: 'Syne', sans-serif;"
      >
        Experiencia
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- Línea vertical -->
      <div class="absolute left-0 top-2 bottom-2 w-px bg-gradient-to-b from-violet-400 via-violet-200 to-transparent" />

      <div class="space-y-8 pl-8">
        {experiences.map((exp, i) => (
          <div
            class="exp-item relative"
            style={`animation-delay: ${i * 150}ms`}
          >
            <!-- Dot -->
            <div class="absolute -left-[37px] top-6 flex items-center justify-center">
              <span class="w-3.5 h-3.5 rounded-full bg-violet-500 ring-4 ring-violet-100 block" />
            </div>

            <!-- Tarjeta -->
            <div class="group bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-100 hover:border-violet-200 hover:bg-white hover:shadow-lg hover:shadow-violet-100/40 transition-all duration-300">

              <!-- Top row -->
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-gray-900 leading-snug">
                    {exp.role}
                    <span class="text-violet-500 font-semibold"> — </span>
                    <a
                      href={exp.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-violet-600 hover:text-violet-800 hover:underline transition-colors"
                    >
                      {exp.company}
                    </a>
                  </h3>
                </div>

                <!-- Badge tipo -->
                <span class="shrink-0 self-start inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-violet-50 text-violet-700 border border-violet-200">
                  {exp.type}
                </span>
              </div>

              <!-- Período -->
              <div class="flex items-center gap-2 text-sm text-gray-400 font-medium mb-4">
                <svg class="w-4 h-4 text-violet-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {exp.period}
              </div>

              <!-- Descripción -->
              <p class="text-gray-600 leading-relaxed text-sm md:text-base">
                {exp.description}
              </p>

              <!-- Tags -->
              <div class="mt-5 flex flex-wrap gap-2">
                {exp.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white border border-gray-200 text-gray-600 group-hover:border-violet-200 group-hover:text-violet-700 transition-colors duration-300">
                    {tag}
                  </span>
                ))}
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&display=swap');

  .exp-item {
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .exp-item.visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const items = document.querySelectorAll('.exp-item');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  items.forEach((item) => observer.observe(item));
</script>